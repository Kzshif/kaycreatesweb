{
  "name": "shorts-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Production pipeline for a YouTube Shorts channel: scripts, fact files, voice, Whisper captions, Remotion animation, QA.",
  "type": "module",
  "scripts": {
    "setup": "bash setup.sh",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "status": "node pipeline/cli.mjs status",
    "new": "node pipeline/cli.mjs new",
    "check": "node pipeline/cli.mjs check",
    "voice": "node pipeline/cli.mjs voice",
    "time": "node pipeline/cli.mjs time",
    "render": "node pipeline/cli.mjs render",
    "qa": "node pipeline/cli.mjs qa",
    "make": "node pipeline/cli.mjs make",
    "next": "node pipeline/cli.mjs next"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/fonts": "4.0.543",
    "@remotion/paths": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "d3-geo": "3.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/react": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "typescript": "^5.8.0"
  }
}
