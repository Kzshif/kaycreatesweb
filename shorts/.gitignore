# dependencies and local tooling (rebuilt by setup.sh)
node_modules/
.venv/
.models/
.cache/

# per-video working files and renders (rebuilt from script + voice + plan)
videos/*/work/
videos/*/out/

# OS / editor
.DS_Store
*.log

# Python bytecode
__pycache__/
*.pyc

# finished videos, zipped and sent per batch (never stored in git)
output/

# style-board stills are sent in chat; only the contact sheet is kept
identity/board/*.png
